{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "connect-to-farm-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"kv_namespaces": [
		{
			"binding": "RATE_LIMIT_KV",
			"id": "53f0a351fa2549e9a56dd68d39261bf5",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA_BUCKET",
			"bucket_name": "connect-to-farm-media",
			"preview_bucket_name": "connect-to-farm-media"
		}
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	}
}